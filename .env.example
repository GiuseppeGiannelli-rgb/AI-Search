# Chiave Tavily (gratuita su https://app.tavily.com)
TAVILY_API_KEY=

# Provider LLM: ollama (locale, default) | openai
# Se vuoto: openai quando c'è OPENAI_API_KEY, altrimenti ollama
PROVIDER=ollama
OPENAI_API_KEY=

# Modelli
OLLAMA_LLM_MODEL=llama3.2
OPENAI_LLM_MODEL=gpt-4o-mini

# Parametri della ricerca
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced
